{
  "name": "@your-org/pptx-editor",
  "version": "1.0.0",
  "description": "A lightweight standalone PPTX rendering and editing engine powered by Rust WASM and TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build rust-engine --target bundler --out-dir pkg",
    "build:wasm:debug": "wasm-pack build rust-engine --debug --target bundler --out-dir pkg",
    "dev:frontend": "npm run build:wasm && rspack dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:wasm && rspack build",
    "start:backend": "cargo run --manifest-path rust-backend/Cargo.toml",
    "test": "vitest run",
    "validate:pptx": "tools/validate-pptx/check.sh",
    "build:wasm:node": "wasm-pack build rust-engine --target nodejs --out-dir pkg-node",
    "headless": "vite-node tools/headless-cli.ts --",
    "agent": "vite-node tools/agent-demo.ts --",
    "render-server": "vite-node tools/render-server.ts --",
    "page-tools": "vite-node tools/export-page-tools.ts --",
    "design": "vite-node tools/design-layer.ts --"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "ajv": "^8.20.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@rspack/cli": "^0.5.0",
    "@rspack/core": "^0.5.0",
    "@types/jsdom": "^30.0.0",
    "concurrently": "^10.0.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1"
  }
}
